{
  "name": "server-and-client",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "setup": "npm install",
    "dev": "npx concurrently \"npx nodemon\" \"node ./scripts/watch_server.js\"",
    "dev:ingame": "npm run build:ingame && npx concurrently \"node ./scripts/watch_client.js\" \"node ./scripts/watch_server.js --mode=ingame\"",
    "dev:mobile": "npm run dev",
    "build": "node ./scripts/build_server.js && node ./scripts/build_client.js",
    "build:ingame": "node ./scripts/build_server.js && node ./scripts/build_client.js",
    "lint": "eslint server && eslint client",
    "watch": "npx concurrently \"npm run watch:server\" \"npm run watch:client\"",
    "watch:client": "esbuild client/client.ts --bundle --target=es6 --watch --outfile=dist/client.js",
    "watch:server": "node scripts/watch_server.js",
    "test": "npx jest --silent",
    "test:watch": "npx jest --watch",
    "tsc": "npm run tsc:client && npm run tsc:server",
    "tsc:client": "tsc --project client/tsconfig.json",
    "tsc:server": "tsc --project server/tsconfig.json"
  },
  "devDependencies": {
    "@citizenfx/client": "^2.0.8552-1",
    "@citizenfx/server": "^2.0.8552-1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "esbuild-plugin-tsc": "^0.5.0",
    "express": "^4.21.2",
    "jest": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.2.5",
    "tsconfig-paths-jest": "^0.0.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@project-error/pe-utils": "^0.2.7",
    "body-parser": "^1.20.3",
    "dayjs": "^1.11.13",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "i18next": "^23.16.8",
    "logform": "^2.7.0",
    "mysql2": "^3.12.0",
    "prettier": "^3.5.1",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.5",
    "tsyringe": "^4.8.0",
    "winston": "^3.17.0",
    "lodash": "^4.17.21"
  }
}
